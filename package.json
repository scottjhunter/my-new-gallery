{
  "name": "eleventy-photo-gallery",
  "version": "1.3.2",
  "description": "Scott Hunter's essays and creative work, built with Eleventy",
  "main": ".eleventy.js",
  "scripts": {
    "build": "npm-run-all clean build:sass build:eleventy",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "start": "npm-run-all watch:*",
    "dev": "npm-run-all --parallel watch:*",
    "build:eleventy": "eleventy",
    "check:seo": "node scripts/check-seo.cjs",
    "check:assets": "node scripts/check-assets.cjs",
    "watch:eleventy": "eleventy --serve",
    "build:sass": "sass --no-source-map src/_includes/sass:src/_includes/css",
    "watch:sass": "sass --no-source-map --watch src/_includes/sass:src/_includes/css",
    "debug": "DEBUG=* @11ty/eleventy",
    "deploy:prod": "npm run build && netlify deploy --prod --dir=_site --site=e5e7f184-38c8-4263-a3ac-9c8924d1378e",
    "deploy:draft": "npm run build && netlify deploy --dir=_site --site=e5e7f184-38c8-4263-a3ac-9c8924d1378e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottjhunter/my-new-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/scottjhunter/my-new-gallery/issues"
  },
  "author": {
    "name": "Tanner Dolby",
    "url": "https://github.com/tannerdolby"
  },
  "keywords": [
    "Essays",
    "Blog",
    "Eleventy",
    "11ty"
  ],
  "homepage": "https://scottjhunter.org",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^4.0.2",
    "@11ty/eleventy-navigation": "^0.3.3",
    "@netlify/blobs": "^10.7.4",
    "clean-css": "^4.2.3",
    "eleventy-plugin-metagen": "^1.8.4",
    "gray-matter": "^4.0.3",
    "npm-run-all": "^4.1.5",
    "sass": "^1.39.0",
    "terser": "^5.7.2"
  },
  "devDependencies": {
    "netlify-cli": "^24.0.1"
  }
}
