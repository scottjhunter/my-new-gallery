<div class="about-me-content">
  <h1>{{ title }}</h1>
  <p class="blog-preview-date"><time datetime="2026-10-18">October 18, 2026</time></p>

<div class="dog-post-photos dog-post-hero">

  <figure><a href="/images/piglet.jpeg" target="_blank" rel="noopener noreferrer">

    {% img src="piglet.jpeg", alt="Piglet curled up asleep in a dog bed beside a laptop; the real photograph.", sizes="(max-width: 600px) 100vw, 400px" %}

