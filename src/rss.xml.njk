---
permalink: "/feed.xml"
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.author.firstName }} {{ site.author.lastName }}</title>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
    <description>{{ site.author.about | xmlEscape | safe }}</description>
    <language>en-us</language>
    <lastBuildDate>{% nowRfc822 %}</lastBuildDate>
{% for post in collections.posts | reverse %}
    <item>
      <title>{{ post.data.title | xmlEscape | safe }}</title>
      <link>{{ post.url | absoluteUrl(site.url) | xmlEscape | safe }}</link>
      <guid isPermaLink="true">{{ post.url | absoluteUrl(site.url) | xmlEscape | safe }}</guid>
{% if post.data.date %}
      <pubDate>{{ post.data.date | dateToRfc822 }}</pubDate>
{% endif %}
{% if post.data.excerpt or post.data.description or post.data.meta_desc %}
      <description>{{ (post.data.excerpt or post.data.description or post.data.meta_desc) | xmlEscape | safe }}</description>
{% endif %}
    </item>
{% endfor %}
  </channel>
</rss>
